# ==============================================
# VICCS Planner — Variáveis de Ambiente
# ==============================================
# Copie este arquivo para .env.local e preencha
# cp .env.example .env.local

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# NUNCA expor no cliente — apenas server-side
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# === Aplicação ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VICCS Planner

# === Vercel (preenchido automaticamente no deploy) ===
# VERCEL_URL=
# VERCEL_ENV=

# === Opcional: Sentry ===
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
